# ---------------------------------------------------------------------------
# GLOBAL — environment variables
# Copy to .env.local for local development. In Netlify, set these under
# Site configuration → Environment variables, then redeploy.
# Never commit real values. None of these are exposed to the browser except
# variables prefixed with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Canonical production URL used for metadata, sitemap, and structured data.
NEXT_PUBLIC_SITE_URL=https://globalaccess.live

# ---------------------------------------------------------------------------
# Form submissions (Request an Invitation + Contact)
# Configure AT LEAST ONE destination below. If none is configured, both forms
# show a clear "opening soon" notice and the API refuses submissions (HTTP 503)
# rather than pretending to accept them.
# ---------------------------------------------------------------------------

# Option A — Supabase (recommended: private, durable storage)
# Run supabase/schema.sql in the Supabase SQL editor first.
# Use the service-role key (legacy JWT) or a secret key (sb_secret_...). Server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional table name overrides
# SUPABASE_APPLICATIONS_TABLE=invitation_applications
# SUPABASE_INQUIRIES_TABLE=contact_inquiries

# Option B — Webhook (e.g. n8n, Make, Zapier). Must be https in production.
# If a secret is set, requests carry X-Global-Signature: sha256=<HMAC of body>.
SUBMISSIONS_WEBHOOK_URL=
SUBMISSIONS_WEBHOOK_SECRET=

# Option C — Email notification via Resend (domain must be verified in Resend)
RESEND_API_KEY=
SUBMISSIONS_NOTIFY_TO=
SUBMISSIONS_NOTIFY_FROM=GLOBAL <notifications@globalaccess.live>

# Local development only: append submissions to .data/submissions.ndjson.
# Ignored in production builds.
# SUBMISSIONS_DEV_STORE=file
